/* LOGOUT */


.logout-page{

height:100vh;

display:flex;

justify-content:center;

align-items:center;

background:linear-gradient(135deg,#08121d,#10263d);

}



.logout-card{

background:#12263d;

padding:50px;

border-radius:25px;

text-align:center;

box-shadow:0 20px 50px rgba(0,0,0,.5);

}



.logout-card h1{

color:#FFD700;

margin-bottom:20px;

}



.logout-card i{

font-size:60px;

color:#FFD700;

margin:20px;

}



.logout-card h2{

margin-bottom:15px;

}



.logout-card p{

color:#ccc;

margin-bottom:30px;

}

/* CONTACT */


.contact-section{

padding:120px 8% 60px;

}



.contact-section h2{

text-align:center;

font-size:40px;

color:#FFD700;

margin-bottom:20px;

}



.contact-grid{

display:grid;

grid-template-columns:repeat(auto-fit,minmax(250px,1fr));

gap:30px;

margin:50px 0;

}



.contact-box{

background:#12263d;

padding:35px;

border-radius:20px;

text-align:center;

}



.contact-box i{

font-size:40px;

color:#FFD700;

margin-bottom:20px;

}



.contact-box a{

color:white;

text-decoration:none;

}



.contact-form{

max-width:800px;

margin:auto;

background:#12263d;

padding:40px;

border-radius:20px;

}



.contact-form form{

display:flex;

flex-direction:column;

gap:20px;

}



.contact-form input,
.contact-form textarea{

padding:15px;

border:none;

border-radius:10px;

font-size:16px;

}



.contact-form textarea{

height:150px;

resize:none;

}

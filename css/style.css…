/* INFORMATIONS */

.info-section{

padding:120px 8% 60px;

}



.info-section h2{

text-align:center;

font-size:40px;

color:#FFD700;

margin-bottom:40px;

}



.info-card{

background:#12263d;

padding:40px;

border-radius:20px;

line-height:1.8;

margin-bottom:40px;

}



.info-card h3{

color:#FFD700;

margin-bottom:20px;

}



.info-grid{

display:grid;

grid-template-columns:repeat(auto-fit,minmax(280px,1fr));

gap:30px;

}



.info-box{

background:#12263d;

padding:35px;

border-radius:20px;

text-align:center;

transition:.4s;

}



.info-box:hover{

transform:translateY(-10px);

}



.info-box i{

font-size:45px;

color:#FFD700;

margin-bottom:20px;

}



.info-box h3{

color:#FFD700;

margin-bottom:15px;

}



.faq{

margin-top:70px;

}



.faq-item{

background:#12263d;

padding:25px;

border-radius:15px;

margin-bottom:20px;

}



.faq-item h3{

color:#FFD700;

margin-bottom:10px;

}

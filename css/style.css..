/* SERVICE CLIENT */

.chat-section{

padding:120px 8% 50px;

min-height:100vh;

}



.chat-section h2{

text-align:center;

font-size:40px;

color:#FFD700;

}



.intro{

text-align:center;

margin:20px;

color:#ccc;

}



.chat-box{

max-width:800px;

height:450px;

margin:30px auto;

background:#12263d;

border-radius:20px;

padding:25px;

overflow-y:auto;

box-shadow:0 15px 40px rgba(0,0,0,.4);

}



.bot-message,
.user-message{

padding:15px;

margin:15px 0;

border-radius:15px;

max-width:75%;

}



.bot-message{

background:#19395c;

}



.user-message{

background:#FFD700;

color:#000;

margin-left:auto;

}



.chat-input{

max-width:800px;

margin:auto;

display:flex;

gap:10px;

}



.chat-input input{

flex:1;

padding:15px;

border-radius:30px;

border:none;

}



.chat-input button{

width:60px;

border:none;

border-radius:50%;

background:#FFD700;

cursor:pointer;

font-size:20px;

}

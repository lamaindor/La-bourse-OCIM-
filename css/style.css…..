/* DEVENIR CLIENT */


.client-section{

padding:120px 8% 60px;

}



.client-section h2{

text-align:center;

color:#FFD700;

font-size:40px;

}



.client-card{

display:grid;

grid-template-columns:repeat(auto-fit,minmax(250px,1fr));

gap:30px;

margin:50px 0;

}



.step{

background:#12263d;

padding:35px;

border-radius:20px;

text-align:center;

transition:.4s;

}



.step:hover{

transform:translateY(-10px);

}



.step i{

font-size:45px;

color:#FFD700;

margin-bottom:20px;

}



.step h3{

color:#FFD700;

margin-bottom:15px;

}



.client-form{

background:#12263d;

padding:40px;

border-radius:20px;

max-width:800px;

margin:auto;

}



.client-form form{

display:flex;

flex-direction:column;

gap:20px;

}



.form-row{

display:grid;

grid-template-columns:1fr 1fr;

gap:20px;

}



.client-form input{

padding:15px;

border-radius:10px;

border:none;

font-size:16px;

}



@media(max-width:700px){

.form-row{

grid-template-columns:1fr;

}

}

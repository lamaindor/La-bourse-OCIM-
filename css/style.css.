/* DASHBOARD */

.dashboard{

padding:120px 8% 50px;

}


.dashboard h2{

text-align:center;

color:#FFD700;

margin-bottom:40px;

}



.dashboard-cards{

display:grid;

grid-template-columns:repeat(auto-fit,minmax(250px,1fr));

gap:25px;

}



.dash-card{

background:#12263d;

padding:35px;

border-radius:20px;

text-align:center;

box-shadow:0 10px 30px rgba(0,0,0,.4);

}



.dash-card i{

font-size:40px;

color:#FFD700;

margin-bottom:20px;

}



.dash-card p{

font-size:25px;

font-weight:bold;

}



.market-panel{

margin-top:50px;

background:#12263d;

padding:30px;

border-radius:20px;

}



.market-panel table{

width:100%;

border-collapse:collapse;

}



.market-panel th{

color:#FFD700;

}



.market-panel td,
.market-panel th{

padding:15px;

border-bottom:1px solid rgba(255,255,255,.1);

text-align:center;

}



.profile{

margin-top:40px;

background:#12263d;

padding:30px;

border-radius:20px;

}


.profile p{

margin:15px;

color:#ddd;

}

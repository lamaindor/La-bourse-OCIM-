/* AVIS CLIENTS */


.reviews{

padding:120px 8% 60px;

}



.reviews h2{

text-align:center;

color:#FFD700;

font-size:40px;

margin-bottom:20px;

}



.subtitle{

text-align:center;

color:#ccc;

margin-bottom:50px;

}



.reviews-container{

display:grid;

grid-template-columns:repeat(auto-fit,minmax(280px,1fr));

gap:30px;

}



.review-card{

background:#12263d;

padding:35px;

border-radius:20px;

text-align:center;

box-shadow:0 10px 30px rgba(0,0,0,.4);

transition:.4s;

}



.review-card:hover{

transform:translateY(-10px);

}



.stars{

color:#FFD700;

font-size:30px;

margin-bottom:20px;

}



.review-card h3{

margin-bottom:15px;

}



.review-card span{

color:#aaa;

font-size:14px;

}



.add-review{

margin-top:70px;

background:#12263d;

padding:40px;

border-radius:20px;

}



.add-review form{

display:flex;

flex-direction:column;

gap:20px;

}



.add-review input,
.add-review select,
.add-review textarea{

padding:15px;

border:none;

border-radius:10px;

font-size:16px;

}



.add-review textarea{

height:150px;

resize:none;

}
